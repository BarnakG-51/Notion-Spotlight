# Groq API Key for LLM
GROQ_API_KEY=your_groq_api_key_here

# Notion OAuth Configuration (for multi-user support)
NOTION_CLIENT_ID=your_notion_client_id_here
NOTION_CLIENT_SECRET=your_notion_client_secret_here
NOTION_REDIRECT_URI=http://localhost:8001/oauth/callback

# Database IDs (users will need to provide these or you can hardcode them)
HABIT_DB_ID=your_habit_database_id_here
TODO_DB_ID=your_todo_database_id_here